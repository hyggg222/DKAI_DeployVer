# Gemini API Key (Required for Plate Recognition)
GEMINI_API_KEY=AIzaSy...YourKeyHere...

# Optional: RTSP Camera URLs (If not set, Server will ask at startup)
RTSP_FRONT=rtsp://admin:password@192.168.1.10:554/stream
RTSP_BACK=rtsp://admin:password@192.168.1.11:554/stream

# Optional: Mobile Host Override (For Android Emulator access)
MOBILE_HOST_OVERRIDE=http://10.0.2.2:8000

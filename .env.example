# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# RTSP Camera URLs (for production server - ai_server.py)
# Format: rtsp://username:password@camera_ip:port/stream_path
# Example: rtsp://admin:password123@192.168.1.100:554/stream1
RTSP_FRONT=rtsp://username:password@camera_ip:554/stream1
RTSP_BACK=rtsp://username:password@camera_ip:554/stream2

# Alternative: Use camera IDs for local USB cameras
# RTSP_FRONT=0
# RTSP_BACK=1

# Server Configuration (Optional)
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# Database Configuration (Optional)
DATABASE_PATH=./registry.db

# Model Configuration (Optional)
VEHICLE_MODEL_PATH=./weights/yolo11s.pt
PLATE_MODEL_PATH=./weights/license-plate-finetune-v1l.pt

# Logging Level (Optional)
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Mobile Host Override (For Android Emulator)
MOBILE_HOST_OVERRIDE=http://10.0.2.2:8001
